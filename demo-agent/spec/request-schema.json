{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/demo-agent/request-schema.json",
  "title": "ConferenceTripRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trip_type",
    "origin",
    "destination_city",
    "date_start",
    "date_end",
    "budget_total_usd",
    "no_red_eye",
    "hotel_nights"
  ],
  "properties": {
    "trip_type": {
      "type": "string",
      "const": "conference"
    },
    "origin": {
      "type": "string",
      "minLength": 2
    },
    "destination_city": {
      "type": "string",
      "minLength": 2
    },
    "destination_airport": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_start": {
      "type": "string",
      "format": "date"
    },
    "date_end": {
      "type": "string",
      "format": "date"
    },
    "budget_total_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "no_red_eye": {
      "type": "boolean"
    },
    "hotel_nights": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "venue_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "preferred_area": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_hotel_distance_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 240
    },
    "hotel_star_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "hotel_star_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "preferred_airlines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refundable_only": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
